# Dockerfile for Python 3.12 FastAPI OR-Tools Optimizer Worker
FROM python:3.12-slim AS base
WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY services/optimizer/pyproject.toml services/optimizer/README.md ./
RUN pip install --upgrade pip && \
    pip install fastapi uvicorn pydantic ortools httpx elevenlabs

COPY services/optimizer/app ./app

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
