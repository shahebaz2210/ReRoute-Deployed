{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web"
    },
    "optimizer": {
      "root": "services/optimizer",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [
    {
      "source": "/optimizer/(.*)",
      "destination": {
        "type": "service",
        "service": "optimizer"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "web"
      }
    }
  ]
}
