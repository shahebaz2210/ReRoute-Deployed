{
  "name": "dispatchx-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "DispatchX (VORTEXA 3.0 / ReRoute) - Autonomous, Human-in-the-Loop Dynamic Logistics Dispatch & Disruption Recovery",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
