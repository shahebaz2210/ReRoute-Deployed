# ==============================================================================
# DispatchX (VORTEXA 3.0 / ReRoute) — Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local and populate the values.
# NEVER commit .env or secret keys to version control.

# --- Core App ---
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# --- Database & Migrations (PostgreSQL 16 + PostGIS) ---
DATABASE_URL=postgresql://dispatch:dispatch@localhost:5432/dispatchx
DATABASE_MIGRATION_URL=postgresql://dispatch:dispatch@localhost:5432/dispatchx

# --- Authentication & RBAC ---
AUTH_SECRET=super-secret-random-32-character-key-here
AUTH_ISSUER_URL=http://localhost:3000
AUTH_CLIENT_ID=dispatchx-web
AUTH_CLIENT_SECRET=optional-client-secret

# --- Python Optimization Worker Service ---
OPTIMIZER_BASE_URL=http://localhost:8000
OPTIMIZER_SHARED_SECRET=optimizer-worker-shared-secret-key-32ch

# --- Routing Engine (Valhalla OSM) ---
VALHALLA_BASE_URL=http://localhost:8002

# --- Optional Geocoding (Photon) ---
PHOTON_BASE_URL=http://localhost:2322

# --- Voice & Speech AI (ElevenLabs) ---
# High-fidelity driver voice transcription (STT) and customer audio synthesis (TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Optional Local Speech Fallbacks ---
STT_MODEL_PATH=
TTS_MODEL_PATH=

# --- Optional Audio & Object Storage (MinIO / S3) ---
AUDIO_STORAGE_ENDPOINT=http://localhost:9000
AUDIO_STORAGE_BUCKET=dispatchx-audio
AUDIO_STORAGE_ACCESS_KEY=minioadmin
AUDIO_STORAGE_SECRET_KEY=minioadmin

# --- Optional Observability (Sentry) ---
SENTRY_DSN=

# ==============================================================================
# Client-Side Variables (Exposed to Browser via NEXT_PUBLIC_*)
# ==============================================================================
# WARNING: NEVER expose database credentials, auth secrets, or API keys here.
NEXT_PUBLIC_APP_NAME=DispatchX
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3000/api/v1/ws
